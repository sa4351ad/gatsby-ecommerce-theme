# ============================================================================
# نظام إدارة الجمعية العمومية والتصويت الإلكتروني — متغيرات البيئة
# انسخ هذا الملف إلى .env (أو .env في كل من apps/api و packages/db) واملأ القيم.
# لا تضع أي قيم حقيقية في هذا الملف — هو مثال فقط.
# ============================================================================

# --- عام / Docker Compose ---
POSTGRES_USER=ga
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=ga_voting

# --- قاعدة البيانات (apps/api و packages/db) ---
DATABASE_URL=postgresql://ga:change_me_strong_password@localhost:5432/ga_voting

# --- apps/api ---
NODE_ENV=development
PORT=4000

# أسرار التوقيع — يجب أن تكون عشوائية وطويلة (32+ حرفًا) ومختلفة في كل بيئة.
# يمكن توليد قيمة عشوائية عبر: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=change_me_min_16_chars
JWT_REFRESH_SECRET=change_me_min_16_chars
VOTE_HASH_SECRET=change_me_min_16_chars
# مفتاح تشفير القيم الحسّاسة في إعدادات النظام (مفاتيح SMS/SMTP) — 32 حرفًا على الأقل
SETTINGS_ENCRYPTION_KEY=change_me_min_32_chars_aes_key

# رابط الواجهة الأمامية — يُستخدم لضبط CORS ومصدر الكوكيز المسموح
WEB_APP_URL=http://localhost:3000

# اترك فارغًا في التطوير المحلي. في الإنتاج، إذا كانت الواجهة والـ API على نطاقات فرعية
# مختلفة لنفس النطاق الأب (مثال: app.example.com وapi.example.com)، اضبطها على النطاق
# الأب المشترك (.example.com) وإلا لن تستطيع الواجهة قراءة كوكي CSRF فتُرفض كل الطلبات.
COOKIE_DOMAIN=

# مجلد تخزين الملفات المرفوعة (صور الأعضاء/المرشحين، مرفقات)
UPLOAD_DIR=./uploads

# المنطقة الزمنية الافتراضية للنظام (تُستخدم في احتساب مواعيد التصويت)
DEFAULT_TIMEZONE=Asia/Riyadh

# --- apps/web ---
# رابط الخادم الخلفي الذي تتصل به الواجهة الأمامية من المتصفح
NEXT_PUBLIC_API_URL=http://localhost:4000
